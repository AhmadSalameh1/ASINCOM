        q = TR_QTY[next_tr] &lt; plant - sent ? TR_QTY[next_tr] : plant - sent;
        if (q &gt; 0.0) { to_dc(TR_DC[next_tr], q); sent += q; }
        next_tr++;
    }
    plant -= sent;
}

